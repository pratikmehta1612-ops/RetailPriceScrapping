# Copy this file to .env (same folder) and fill in your keys.
# Restart the app after changing it.
# .env is listed in .gitignore, so your keys never get pushed to GitHub.
# Keep this .env.example file free of real keys: it IS pushed.

# ---------------------------------------------------------------- login
# Users and their hashed passwords. Don't edit by hand: use
#   python -m scripts.manage_users add <name>
APP_USERS=
# Signs login cookies. manage_users fills it in with a random value.
SESSION_SECRET=
# Real searches each user may run per 24 hours (0 = no limit). Sample data is free.
DAILY_SEARCH_LIMIT=15

# ---------------------------------------------------------------- required
# Searches Google Shopping. Free plan: 250 searches/month.
# Get a key at https://serpapi.com/users/sign_up
SERPAPI_API_KEY=

# ---------------------------------------------------------------- optional AI matching
# With a key, Claude reads the reference page, lists the attributes that matter,
# writes better searches and judges each result. Costs roughly a cent per search
# with the default model. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Set to false to keep the key but turn AI off.
USE_AI=true

# ---------------------------------------------------------------- search options
# Country and language for Google Shopping (us, ca, gb, in, au...).
SEARCH_COUNTRY=us
SEARCH_LANGUAGE=en
# Optional city-level location, e.g. "Austin, Texas, United States".
SEARCH_LOCATION=

# Searches per reference product (each uses 1 SerpApi credit, ~40 products each).
MAX_QUERIES=3
# Direct store links looked up automatically for the top results (1 credit each).
# Other results get a "Get store link" button. Set to 0 to save credits.
STORE_LINK_LOOKUPS=10
# Always show at least this many results, and at most this many.
MIN_RESULTS=10
MAX_RESULTS=30

# ---------------------------------------------------------------- reading the reference page
RESPECT_ROBOTS=true
REQUEST_TIMEOUT=20
# Refuse links to private/internal network addresses (keep true when hosted).
BLOCK_PRIVATE_ADDRESSES=true
# Login cookies only over https: auto, true or false.
COOKIE_SECURE=auto
