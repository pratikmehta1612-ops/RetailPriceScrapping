# Copy to .env and adjust. All settings are optional.

# Where the SQLite database lives.
DATABASE_PATH=data/prices.db

# Honour each site's robots.txt (recommended).
RESPECT_ROBOTS=true

# Minimum seconds between two requests to the same site.
MIN_REQUEST_INTERVAL=3

# Request timeout in seconds.
REQUEST_TIMEOUT=20

# Re-scrape every saved product on this interval (hours). 0 = off.
REFRESH_INTERVAL_HOURS=0

# Optional: official Best Buy Products API key (https://developer.bestbuy.com).
# Enables reliable Best Buy lookups and the /api/search endpoint.
BESTBUY_API_KEY=
